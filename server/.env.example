# Required paths and in-house LLM
DATA_DIR=C:\aioffice-data
LLM_BASE_URL=http://intranet-llm.example/v1
LLM_API_KEY=
LLM_MODEL_DEFAULT=
LLM_TIMEOUT_SEC=300
LLM_MAX_TOKENS=8192
LLM_TEMPERATURE=0.2
LLM_DISABLE_THINKING=false
LLM_CONTEXT_TOKENS=32768
KO_TOKENS_PER_CHAR=1.0
LLM_MAX_CONCURRENCY=4

# Embeddings and vector search
EMBED_BASE_URL=
EMBED_API_KEY=
EMBED_MODEL=BAAI-bge-m3
EMBED_BATCH_SIZE=32

# Optional reranker (search_reports)
RERANK_BASE_URL=
RERANK_API_KEY=
RERANK_MODEL=BAAI-bge-reranker-v2-m3
RERANK_API_STYLE=cohere
RERANK_BATCH_SIZE=32
